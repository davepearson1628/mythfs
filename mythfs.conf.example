[mythfs]
# FUSE mount exposed to local applications, SMB and NFS.
mountpoint = /media/mythfs

# MythFS normally discovers every MythTV "Default" Storage Group directory
# directly from the MythTV database.
discover_storage_groups = yes

# Optional locally accessible fallback/override recording directories.
# Use a comma-separated list. This is particularly useful when storage
# belonging to another backend is mounted under a different local path.
#
# storage_dirs = /mnt/myth-recordings-1, /mnt/myth-recordings-2
#
# The old singular option is also accepted for backwards compatibility:
# storage_dir = /media/myth/tv

refresh = 60

exclude_groups = Deleted, LiveTV
movie_groups = Movies
include_all_groups = no

tmdb_grabber = /usr/share/mythtv/metadata/Movie/tmdb3.py
cache_file = /var/cache/mythfs/movie-years.json

# Required when the FUSE filesystem is to be read by Samba, NFS or users
# other than the account running MythFS. Also enable user_allow_other in
# /etc/fuse.conf.
allow_other = yes

debug = no
debug_fuse = no
